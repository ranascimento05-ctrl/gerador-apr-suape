{
  "buildCommand": "pip install -r requirements.txt",
  "devCommand": "python -m http.server 3000",
  "framework": "other",
  "public": ".",
  "functions": {
    "api/generate.py": {
      "runtime": "python3.11"
    }
  },
  "env": {
    "PYTHONPATH": "."
  },
  "rewrites": [
    {
      "source": "/api/generate",
      "destination": "/api/generate.py"
    }
  ]
}
